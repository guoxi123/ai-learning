# ===== LLM 配置 =====
# 必填（除非开启 LLM_MOCK）：你的 API Key（默认 DeepSeek，https://platform.deepseek.com 申请）
LLM_API_KEY=sk-在这里填你的-key

# 切换厂商只需改这三项（三家都兼容 OpenAI 的 /chat/completions 流式协议）
# DeepSeek: https://api.deepseek.com                          / deepseek-chat
# OpenAI:   https://api.openai.com/v1                         / gpt-4o-mini
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1 / qwen-plus
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 开发演示模式 =====
# 为 true 时跳过真实 LLM，直接流式推送一段预设表格内容，无需 API Key。
# 想立即看流式表格效果又没 key 时设为 true；接入真实 LLM 时改回 false。
LLM_MOCK=false

# mock 首字延迟（秒）：>0 时模拟「连接建立但迟迟不出字」，用于测试前端的无响应超时
LLM_MOCK_DELAY=0.0

# ===== 服务 =====
PORT=8000
REQUEST_TIMEOUT=60.0

# CORS 白名单（JSON 数组格式；本地 Vite 默认 5173）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 可选：覆盖默认 system prompt（留空使用内置的表格引导 prompt）
# SYSTEM_PROMPT=
